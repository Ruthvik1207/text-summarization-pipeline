{
  "name": "summarai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FastAPI backend runner",
  "scripts": {
    "start": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "mlflow": "py -3.14 -m mlflow server --backend-store-uri sqlite:///mlflow.db --default-artifact-root ./mlflow-artifacts --host 127.0.0.1 --port 5000",
    "test": "py -3.14 -m pytest tests/ -v"
  }
}
