# Application Configuration
PROJECT_NAME="Text Summarization Pipeline"
APP_BRANDING="SummarAI — Intelligent Text Summarization & MLOps Platform"
APP_VERSION=1.0.0
API_V1_STR=/api/v1

# NLP Transformer Model Configuration
# Options: google/flan-t5-small, google/flan-t5-base
MODEL_NAME=google/flan-t5-small
MODEL_VERSION=1.0.0
DEVICE=cpu
MAX_INPUT_LENGTH=2048
DEFAULT_MAX_OUTPUT_LENGTH=150
DEFAULT_MIN_OUTPUT_LENGTH=40

# Database Persistence
DATABASE_URL=sqlite:///./data/summarai.db

# MLOps: MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=text-summarization
MLFLOW_REGISTERED_MODEL_NAME=text-summarization-model

# Continuous Learning Thresholds
MIN_ROUGE_L_THRESHOLD=0.35

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
